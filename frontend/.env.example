# Internal API base. Reachable from the frontend container.
# In production this should be the internal-only DNS record.
CLOUD_API_BASE_URL=http://api.cloud.calpolysoc.org

# Floci AWS-compatible endpoint (defaults to CLOUD_API_BASE_URL if unset)
FLOCI_ENDPOINT_URL=http://api.cloud.calpolysoc.org

# AWS SDK creds (Floci accepts dummy values, but the SDK requires non-empty ones)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ---- Auth.js / Keycloak SSO ----
# Random secret for JWT signing. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# Public URL the browser uses to reach the console (must match the Keycloak
# client's "Valid redirect URIs"). No trailing slash.
AUTH_URL=https://cloud.calpolysoc.org

# Trust X-Forwarded-* headers from Nginx (we run behind a reverse proxy).
AUTH_TRUST_HOST=true

# Keycloak client (create a confidential client in the `calpolysoc` realm
# with redirect URI: <AUTH_URL>/api/auth/callback/keycloak)
AUTH_KEYCLOAK_ID=cloud-console
AUTH_KEYCLOAK_SECRET=replace-me
AUTH_KEYCLOAK_ISSUER=https://auth.calpolysoc.org/realms/calpolysoc

# Proxmox live discovery. The console queries Proxmox directly for template VMs
# and synthesizes the image catalog from those results.
PROXMOX_HOST=172.21.1.22
PROXMOX_PORT=8006
PROXMOX_PROTOCOL=https
PROXMOX_TOKEN_ID=cloudbot@pve!mvp-token
PROXMOX_TOKEN_SECRET=replace-me
PROXMOX_NODE=kitasanblack
PROXMOX_STORAGE=local-lvm
PROXMOX_BRIDGE=vmbr0
PROXMOX_REGION=us-east-1

# Most Proxmox installs expose a self-signed certificate internally.
PROXMOX_ALLOW_INSECURE_TLS=true

# By default the console only exposes templates whose names start with `tmpl-`.
# Set this blank to include every Proxmox template VM.
PROXMOX_TEMPLATE_NAME_PREFIX=tmpl-

# Optional overrides.
# PROXMOX_API_BASE_URL=https://172.21.1.22:8006/api2/json
# PROXMOX_DEFAULT_IMAGE_ID=ami-ubuntu-2404
