def capacity_summary(args):
    pve = Proxmox()
    payload = {
        "node": pve.node,
        "status": pve.node_status(),
        "storage": pve.storage_status(),
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return
    print(f"Node: {pve.node}")
    status = payload["status"]
    print(f"CPU: {status.get('cpu')}")
    print(f"Memory: {status.get('memory', {}).get('used')} / {status.get('memory', {}).get('total')}")
    for storage in payload["storage"]:
        print(
            f"Storage {storage.get('storage')}: "
            f"{storage.get('used')} / {storage.get('total')} "
            f"({storage.get('content')})"
        )


def provision_service(args):
    password = args.password
    if args.password_env:
        password = os.environ.get(args.password_env)
    if not password:
        print("Missing service password", file=sys.stderr)
        sys.exit(1)

    pve = Proxmox(template_id=args.template_vmid)
    if args.instance_type not in INSTANCE_TYPES:
        print(f"Unsupported instance type: {args.instance_type}", file=sys.stderr)
        sys.exit(1)

    vmid = pve.next_vmid()
    service = args.service.lower()
    if service == "postgres":
        user_data = postgres_cloud_init(args.username, password, args.port)
        bootstrap_script = postgres_bootstrap_script(args.username, password, args.port)
    elif service == "redis":
        user_data = redis_cloud_init(password, args.port)
        bootstrap_script = redis_bootstrap_script(password, args.port)
    else:
        print(f"Unsupported managed service: {args.service}", file=sys.stderr)
        sys.exit(1)

    snippet_ref = None
    seed_iso_ref = None
    if not args.no_snippet:
        filename = f"calpolysoc-{service}-{vmid}.yaml"
        try:
            snippet_ref = pve.upload_snippet(filename, user_data)
        except RuntimeError as exc:
            print(
                f"Warning: cloud-init snippet upload failed, trying seed ISO fallback: {exc}",
                file=sys.stderr,
            )
            try:
                seed_iso_ref = pve.upload_seed_iso(vmid, service, user_data)
            except RuntimeError as iso_exc:
                print(
                    f"Warning: seed ISO fallback failed, falling back to guest-agent bootstrap: {iso_exc}",
                    file=sys.stderr,
                )

    pve.clone_template(vmid, args.name)
    extra_config = {}
    if snippet_ref:
        extra_config["cicustom"] = f"user={snippet_ref}"
    elif seed_iso_ref:
        extra_config["ide2"] = f"{seed_iso_ref},media=cdrom"
    pve.configure_vm(
        vmid,
        args.name,
        args.instance_type,
        args.cloud_user,
        args.cloud_password,
        extra_config=extra_config,
    )

    if args.storage_gib:
        config = pve.config_vm(vmid)
        disk = root_disk_key(config)
        if disk:
            pve.resize_disk(vmid, disk, args.storage_gib)

    pve.start_vm(vmid)
    ip = pve.wait_guest_ip(vmid, timeout=args.ip_timeout)
    bootstrap = None
    if not snippet_ref and not seed_iso_ref:
        bootstrap = pve.guest_exec(vmid, bootstrap_script, timeout=args.bootstrap_timeout)
        ip = ip or pve.wait_guest_ip(vmid, timeout=120)
    payload = {
        "ok": True,
        "service": service,
        "vmid": vmid,
        "instance_id": f"i-{vmid:08d}",
        "name": args.name,
        "ip": ip,
        "endpoint_address": ip,
        "endpoint_port": int(args.port),
        "snippet": snippet_ref,
        "seed_iso": seed_iso_ref,
        "bootstrap": bootstrap,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return
    for key, value in payload.items():
        print(f"{key}: {value}")


def main():
    load_env()

    parser = argparse.ArgumentParser(description="CalPolySOC private cloud MVP controller")
    sub = parser.add_subparsers(dest="command", required=True)

    run = sub.add_parser("run-instance")
    run.add_argument("--name", required=True)
    run.add_argument("--ami", default="ami-ubuntu-2404")
    run.add_argument("--template-vmid")
    run.add_argument("--template-id")
    run.add_argument("--template-name")
    run.add_argument("--instance-type", default="t3.small")
    run.add_argument("--user", default="ubuntu")
    run.add_argument("--password")
    run.add_argument("--password-env")
    run.add_argument("--ssh-key")
    run.set_defaults(func=run_instance)

    desc = sub.add_parser("describe-instances")
    desc.add_argument("--vmid")
    desc.add_argument("--json", action="store_true")
    desc.set_defaults(func=describe_instances)

    start = sub.add_parser("start-instance")
    start.add_argument("--vmid", required=True)
    start.set_defaults(func=start_instance)

    stop = sub.add_parser("stop-instance")
    stop.add_argument("--vmid", required=True)
    stop.set_defaults(func=stop_instance)

    term = sub.add_parser("terminate-instance")
    term.add_argument("--vmid", required=True)
    term.set_defaults(func=terminate_instance)

    attach = sub.add_parser("attach-volume")
    attach.add_argument("--vmid", required=True)
    attach.add_argument("--volume-id", required=True)
    attach.add_argument("--size-gib", required=True)
    attach.add_argument("--device")
    attach.add_argument("--backing")
    attach.add_argument("--unused-key")
    attach.set_defaults(func=attach_volume)

    detach = sub.add_parser("detach-volume")
    detach.add_argument("--vmid", required=True)
    detach.add_argument("--device")
    detach.add_argument("--backing")
    detach.set_defaults(func=detach_volume)

    delete_disk = sub.add_parser("delete-volume-backing")
    delete_disk.add_argument("--vmid", required=True)
    delete_disk.add_argument("--unused-key")
    delete_disk.add_argument("--backing")
    delete_disk.set_defaults(func=delete_volume_backing)

    snapshot = sub.add_parser("create-volume-snapshot")
    snapshot.add_argument("--snapshot-id", required=True)
    snapshot.add_argument("--volume-id", required=True)
    snapshot.add_argument("--vmid")
    snapshot.add_argument("--device")
    snapshot.add_argument("--backing")
    snapshot.set_defaults(func=create_volume_snapshot)

    capacity = sub.add_parser("capacity-summary")
    capacity.add_argument("--json", action="store_true")
    capacity.set_defaults(func=capacity_summary)

    service = sub.add_parser("provision-service")
    service.add_argument("--service", required=True, choices=["postgres", "redis"])
    service.add_argument("--name", required=True)
    service.add_argument("--instance-type", required=True)
    service.add_argument("--storage-gib", type=int, required=True)
    service.add_argument("--username", required=True)
    service.add_argument("--password")
    service.add_argument("--password-env")
    service.add_argument("--port", type=int, required=True)
    service.add_argument("--template-vmid")
    service.add_argument("--cloud-user", default="ubuntu")
    service.add_argument("--cloud-password")
    service.add_argument("--ip-timeout", type=int, default=900)
    service.add_argument("--bootstrap-timeout", type=int, default=900)
    service.add_argument("--no-snippet", action="store_true")
    service.add_argument("--json", action="store_true")
    service.set_defaults(func=provision_service)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
