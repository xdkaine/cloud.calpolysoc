def run_instance(args):
    template_id = args.template_vmid or args.template_id
    pve = Proxmox(template_id=template_id)

    if args.instance_type not in INSTANCE_TYPES:
        print(f"Unsupported instance type: {args.instance_type}", file=sys.stderr)
        sys.exit(1)

    password = args.password
    if args.password_env:
        password = os.environ.get(args.password_env)
        if password is None:
            print(
                f"Password environment variable is not set: {args.password_env}",
                file=sys.stderr,
            )
            sys.exit(1)

    if password is None:
        password = "ChangeMe123!"

    vmid = pve.next_vmid()
    instance_id = f"i-{vmid:08d}"
    name = args.name

    print(f"Launching {instance_id}")
    print(f"Node: {pve.node}")
    print(f"Template: {pve.template_id}")
    print(f"VMID: {vmid}")
    print(f"Name: {name}")
    print(f"Instance type: {args.instance_type}")

    pve.clone_template(vmid, name)
    pve.configure_vm(
        vmid,
        name,
        args.instance_type,
        args.user,
        password,
        ssh_key=args.ssh_key,
    )
    pve.start_vm(vmid)

    status = pve.status_vm(vmid)

    print("")
    print("Instance launched:")
    print(f"  InstanceId: {instance_id}")
    print(f"  ProxmoxVMID: {vmid}")
    print(f"  Name: {name}")
    print(f"  State: {status.get('status')}")
    print(f"  Node: {pve.node}")


def describe_instances(args):
    pve = Proxmox()
    instances = []

    for vm in pve.list_vms():
        vmid = int(vm.get("vmid"))
        if args.vmid and vmid != int(args.vmid):
            continue

        if args.json:
            instances.append(format_instance(pve, vm))
            continue

        owner = parse_owner_metadata(pve.config_vm(vmid).get("description"))
        owner_suffix = ""
        if owner:
            owner_suffix = f"  owner={owner.get('principal') or owner.get('email')}"

        print(
            f"i-{vmid:08d}  "
            f"vmid={vmid}  "
            f"name={vm.get('name')}  "
            f"state={vm.get('status')}"
            f"{owner_suffix}"
        )

    if args.json:
        print(json.dumps({"instances": instances}, indent=2, sort_keys=True))


def start_instance(args):
    pve = Proxmox()
    pve.start_vm(int(args.vmid))
    print(f"Started i-{int(args.vmid):08d}")


def stop_instance(args):
    pve = Proxmox()
    pve.stop_vm(int(args.vmid))
    print(f"Stopped i-{int(args.vmid):08d}")


def terminate_instance(args):
    pve = Proxmox()
    pve.delete_vm(int(args.vmid))
    print(f"Terminated i-{int(args.vmid):08d}")


def attach_volume(args):
    pve = Proxmox()
    vmid = int(args.vmid)
    config = pve.config_vm(vmid)
    device = find_free_disk_key(config, args.device)

    backing = args.backing
    data = {}
    if args.unused_key:
        if args.unused_key not in config:
            print(f"Unused disk not found: {args.unused_key}", file=sys.stderr)
            sys.exit(1)
        backing = config[args.unused_key]
        data["delete"] = args.unused_key

    if backing:
        data[device] = backing
    else:
        data[device] = f"{pve.storage}:{int(args.size_gib)}"

    pve.post(f"/nodes/{pve.node}/qemu/{vmid}/config", data=data)
    updated = pve.config_vm(vmid)
    print(
        json.dumps(
            {
                "ok": True,
                "vmid": vmid,
                "volume_id": args.volume_id,
                "device": device,
                "backing": updated.get(device),
            },
            sort_keys=True,
        )
    )


def detach_volume(args):
    pve = Proxmox()
    vmid = int(args.vmid)
    config = pve.config_vm(vmid)
    device = args.device or find_disk_by_backing(config, args.backing)
    if not device or device not in config:
        print("Attached disk not found", file=sys.stderr)
        sys.exit(1)

    backing = config[device]
    pve.post(
        f"/nodes/{pve.node}/qemu/{vmid}/config",
        data={"delete": device},
    )
    updated = pve.config_vm(vmid)
    unused_key = find_unused_by_backing(updated, backing)
    print(
        json.dumps(
            {
                "ok": True,
                "vmid": vmid,
                "device": device,
                "backing": backing,
                "unused_key": unused_key,
            },
            sort_keys=True,
        )
    )


def delete_volume_backing(args):
    pve = Proxmox()
    vmid = int(args.vmid)
    config = pve.config_vm(vmid)
    unused_key = args.unused_key or find_unused_by_backing(config, args.backing)
    if not unused_key or unused_key not in config:
        print("Unused disk not found", file=sys.stderr)
        sys.exit(1)
    backing = config[unused_key]
    pve.post(
        f"/nodes/{pve.node}/qemu/{vmid}/config",
        data={"delete": unused_key},
    )
    print(
        json.dumps(
