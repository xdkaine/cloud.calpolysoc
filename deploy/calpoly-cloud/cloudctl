import requests

requests.packages.urllib3.disable_warnings()

ENV_FILE = "/etc/calpoly-cloud/proxmox.env"
OWNER_METADATA_PREFIX = "calpolysoc_owner="

INSTANCE_TYPES = {
    "t3.nano": {"cores": 1, "memory": 512},
    "t3.micro": {"cores": 1, "memory": 1024},
    "t3.small": {"cores": 1, "memory": 2048},
    "t3.medium": {"cores": 2, "memory": 4096},
    "t3.large": {"cores": 2, "memory": 8192},
    "t3.xlarge": {"cores": 4, "memory": 16384},
    "c6i.large": {"cores": 2, "memory": 4096},
    "c6i.xlarge": {"cores": 4, "memory": 8192},
    "m6i.large": {"cores": 2, "memory": 8192},
    "m6i.xlarge": {"cores": 4, "memory": 16384},
    "r6i.large": {"cores": 2, "memory": 16384},
    "r6i.xlarge": {"cores": 4, "memory": 32768},
}


def load_env():
    if not Path(ENV_FILE).exists():
        print(f"Missing config: {ENV_FILE}", file=sys.stderr)
        sys.exit(1)

    with open(ENV_FILE, encoding="utf-8") as handle:
        for raw_line in handle:
            line = raw_line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            if line.startswith("export "):
                line = line[len("export ") :]
            key, value = line.split("=", 1)
            os.environ[key.strip()] = value.strip().strip('"').strip("'")


def env_bool(name, default=False):
    raw = os.environ.get(name)
    if raw is None:
        return default
    return raw.strip().lower() in {"1", "true", "yes", "on"}


def coerce_int(value):
    if isinstance(value, int):
        return value
    if isinstance(value, str) and value.isdigit():
        return int(value)
    return None


def parse_owner_metadata(description):
    for line in (description or "").splitlines():
        if not line.startswith(OWNER_METADATA_PREFIX):
            continue

        encoded = line[len(OWNER_METADATA_PREFIX) :].strip()
        try:
            decoded = urllib.parse.unquote(encoded)
            payload = json.loads(decoded)
        except (json.JSONDecodeError, ValueError):
            return None

        if isinstance(payload, dict):
            return payload

    return None


def infer_instance_type(config, vm):
    cores = coerce_int(config.get("cores")) or coerce_int(vm.get("cpus"))
    memory_mib = coerce_int(config.get("memory"))
    if memory_mib is None:
        maxmem = coerce_int(vm.get("maxmem"))
        if maxmem:
            memory_mib = maxmem // 1024 // 1024

    for name, spec in INSTANCE_TYPES.items():
        if cores == spec["cores"] and memory_mib == spec["memory"]:
            return name

    return None


class Proxmox:
    def __init__(self, template_id=None):
        self.host = os.environ["PROXMOX_HOST"]
        self.node = os.environ["PROXMOX_NODE"]
        self.token_id = os.environ["PROXMOX_TOKEN_ID"]
        self.token_secret = os.environ["PROXMOX_TOKEN_SECRET"]
        self.template_id = int(template_id or os.environ.get("PROXMOX_TEMPLATE_ID", "9001"))
        self.storage = os.environ.get("PROXMOX_STORAGE", "local-lvm")
        self.bridge = os.environ.get("PROXMOX_BRIDGE", "vmbr0")
        protocol = os.environ.get("PROXMOX_PROTOCOL", "https")
        port = os.environ.get("PROXMOX_PORT", "8006")
        self.base = os.environ.get(
            "PROXMOX_API_BASE_URL",
            f"{protocol}://{self.host}:{port}",
        ).rstrip("/")
        if not self.base.endswith("/api2/json"):
            self.base += "/api2/json"
        self.verify = not env_bool("PROXMOX_ALLOW_INSECURE_TLS", default=True)
        self.headers = {
            "Authorization": f"PVEAPIToken={self.token_id}={self.token_secret}"
        }

    def get(self, path):
        response = requests.get(
            f"{self.base}{path}",
            headers=self.headers,
            verify=self.verify,
            timeout=30,
        )
        self.check(response)
        return response.json()["data"]

    def post(self, path, data=None, files=None, timeout=60):
        response = requests.post(
            f"{self.base}{path}",
            headers=self.headers,
            data=data or {},
            files=files,
            verify=self.verify,
            timeout=timeout,
        )
        self.check(response)
        return response.json().get("data")

    def put(self, path, data=None):
        response = requests.put(
            f"{self.base}{path}",
            headers=self.headers,
            data=data or {},
            verify=self.verify,
            timeout=60,
        )
        self.check(response)
        return response.json().get("data")

    def delete(self, path, data=None):
        response = requests.delete(
            f"{self.base}{path}",
            headers=self.headers,
            params=data or {},
            verify=self.verify,
            timeout=60,
        )
        self.check(response)
        return response.json().get("data")

    def check(self, response):
        if response.status_code >= 400:
            print("Proxmox API error:", file=sys.stderr)
            print(response.status_code, response.text, file=sys.stderr)
            sys.exit(1)

    def wait_task(self, upid, timeout=900):
        encoded = urllib.parse.quote(upid, safe="")
        start = time.time()

        while time.time() - start < timeout:
            status = self.get(f"/nodes/{self.node}/tasks/{encoded}/status")

            if status.get("status") == "stopped":
                exitstatus = status.get("exitstatus")
                if exitstatus == "OK":
                    return
                print(f"Task failed: {exitstatus}", file=sys.stderr)
                sys.exit(1)

            time.sleep(2)

        print(f"Timed out waiting for task: {upid}", file=sys.stderr)
        sys.exit(1)

    def next_vmid(self):
        return int(self.get("/cluster/nextid"))

    def clone_template(self, vmid, name):
        upid = self.post(
            f"/nodes/{self.node}/qemu/{self.template_id}/clone",
            data={
                "newid": vmid,
                "name": name,
                "full": 1,
                "storage": self.storage,
            },
        )
        self.wait_task(upid)

    def configure_vm(
        self,
        vmid,
        name,
        instance_type,
        user,
        password,
        ssh_key=None,
        extra_config=None,
    ):
        spec = INSTANCE_TYPES[instance_type]

        data = {
            "name": name,
            "cores": spec["cores"],
            "memory": spec["memory"],
            "net0": f"virtio,bridge={self.bridge}",
            "ipconfig0": "ip=dhcp",
            "ciuser": user,
            "agent": "enabled=1",
        }

        if password:
            data["cipassword"] = password
        if ssh_key:
            data["sshkeys"] = ssh_key
        if extra_config:
            data.update(extra_config)

        self.post(f"/nodes/{self.node}/qemu/{vmid}/config", data=data)

    def start_vm(self, vmid):
        upid = self.post(f"/nodes/{self.node}/qemu/{vmid}/status/start")
        self.wait_task(upid)

    def stop_vm(self, vmid):
        upid = self.post(f"/nodes/{self.node}/qemu/{vmid}/status/stop")
        self.wait_task(upid)

    def delete_vm(self, vmid):
        upid = self.delete(
            f"/nodes/{self.node}/qemu/{vmid}",
            data={
                "purge": 1,
                "destroy-unreferenced-disks": 1,
            },
        )
        self.wait_task(upid)

    def status_vm(self, vmid):
        return self.get(f"/nodes/{self.node}/qemu/{vmid}/status/current")

    def config_vm(self, vmid):
        return self.get(f"/nodes/{self.node}/qemu/{vmid}/config")

    def list_vms(self):
        return self.get(f"/nodes/{self.node}/qemu")

    def resize_disk(self, vmid, disk, size_gib):
        upid = self.put(
            f"/nodes/{self.node}/qemu/{vmid}/resize",
            data={"disk": disk, "size": f"{int(size_gib)}G"},
        )
        self.wait_task(upid)

    def ensure_snippet_storage(self, storage):
        config = self.get(f"/storage/{storage}")
        content = str(config.get("content") or "")
        values = [item.strip() for item in content.split(",") if item.strip()]
        if "snippets" in values:
            return
        values.append("snippets")
        self.put(f"/storage/{storage}", data={"content": ",".join(values)})

    def upload_snippet(self, filename, content):
        storage = os.environ.get("PROXMOX_SNIPPETS_STORAGE", "local")
        self.ensure_snippet_storage(storage)
        files = {
            "filename": (
                filename,
                content.encode("utf-8"),
                "text/cloud-config",
            )
        }
        response = requests.post(
            f"{self.base}/nodes/{self.node}/storage/{storage}/upload",
            headers=self.headers,
            data={"content": "snippets"},
            files=files,
            verify=self.verify,
            timeout=120,
        )
        if response.status_code >= 400:
            raise RuntimeError(
                f"snippet upload failed: HTTP {response.status_code} {response.text}"
            )
        result = response.json().get("data")
        if isinstance(result, str) and result.startswith("UPID:"):
            self.wait_task(result)
        return f"{storage}:snippets/{filename}"

    def upload_iso_file(self, filename, path):
        storage = os.environ.get("PROXMOX_ISO_STORAGE", "local")
        with open(path, "rb") as handle:
            files = {"filename": (filename, handle, "application/octet-stream")}
            response = requests.post(
                f"{self.base}/nodes/{self.node}/storage/{storage}/upload",
                headers=self.headers,
                data={"content": "iso"},
                files=files,
                verify=self.verify,
                timeout=300,
            )
        if response.status_code >= 400:
            raise RuntimeError(
                f"ISO upload failed: HTTP {response.status_code} {response.text}"
            )
        result = response.json().get("data")
        if isinstance(result, str) and result.startswith("UPID:"):
            self.wait_task(result)
        return f"{storage}:iso/{filename}"

    def upload_seed_iso(self, vmid, service, user_data):
        tool = shutil.which("genisoimage") or shutil.which("mkisofs")
        if not tool:
            raise RuntimeError("genisoimage or mkisofs is required for seed ISO fallback")

        filename = f"calpolysoc-{service}-{vmid}-seed.iso"
        with tempfile.TemporaryDirectory() as directory:
            workdir = Path(directory)
            (workdir / "user-data").write_text(user_data, encoding="utf-8")
            (workdir / "meta-data").write_text(
                f"instance-id: calpolysoc-{service}-{vmid}\n"
                f"local-hostname: calpolysoc-{service}-{vmid}\n",
                encoding="utf-8",
            )
            iso_path = workdir / filename
            result = subprocess.run(
                [
                    tool,
                    "-quiet",
                    "-output",
                    str(iso_path),
                    "-volid",
                    "cidata",
                    "-joliet",
                    "-rock",
                    str(workdir / "user-data"),
                    str(workdir / "meta-data"),
                ],
                capture_output=True,
                text=True,
            )
            if result.returncode != 0:
                raise RuntimeError(
                    f"seed ISO creation failed: {(result.stderr or result.stdout).strip()}"
                )
            return self.upload_iso_file(filename, iso_path)

    def guest_network_interfaces(self, vmid):
        try:
            return self.get(f"/nodes/{self.node}/qemu/{vmid}/agent/network-get-interfaces")
        except SystemExit:
            raise

    def guest_exec(self, vmid, script, timeout=900):
        result = self.post(
            f"/nodes/{self.node}/qemu/{vmid}/agent/exec",
            data={
                "command": "bash",
                "input-data": script,
                "capture-output": "1",
            },
            timeout=120,
        )
        pid = result.get("pid") if isinstance(result, dict) else result
        if not pid:
            print("Guest agent exec did not return a pid", file=sys.stderr)
            sys.exit(1)

        start = time.time()
        while time.time() - start < timeout:
            status = self.get(
                f"/nodes/{self.node}/qemu/{vmid}/agent/exec-status?pid={pid}"
            )
            if status.get("exited"):
                exitcode = status.get("exitcode", 0)
                if exitcode == 0:
                    return status
                out = status.get("out-data") or ""
                err = status.get("err-data") or ""
                print(f"Guest bootstrap failed with exit code {exitcode}", file=sys.stderr)
                if out:
                    print(out, file=sys.stderr)
                if err:
                    print(err, file=sys.stderr)
                sys.exit(1)
            time.sleep(5)

        print("Timed out waiting for guest bootstrap", file=sys.stderr)
        sys.exit(1)

    def wait_guest_ip(self, vmid, timeout=300):
        start = time.time()
        while time.time() - start < timeout:
            try:
                interfaces = self.guest_network_interfaces(vmid)
            except SystemExit:
                interfaces = []
            for interface in interfaces or []:
                for address in interface.get("ip-addresses", []) or []:
                    ip = address.get("ip-address")
                    if address.get("ip-address-type") != "ipv4":
                        continue
                    if not ip or ip.startswith("127.") or ip.startswith("169.254."):
                        continue
                    return ip
            time.sleep(5)
        return None

    def node_status(self):
        return self.get(f"/nodes/{self.node}/status")

    def storage_status(self):
        return self.get(f"/nodes/{self.node}/storage")


def format_instance(pve, vm):
    vmid = int(vm.get("vmid"))
    config = pve.config_vm(vmid)
    owner = parse_owner_metadata(config.get("description"))
    memory_mib = coerce_int(config.get("memory"))
    maxmem = coerce_int(vm.get("maxmem"))
    if maxmem is None and memory_mib is not None:
        maxmem = memory_mib * 1024 * 1024

    instance = {
        "instance_id": f"i-{vmid:08d}",
        "vmid": vmid,
        "name": vm.get("name") or config.get("name"),
        "status": vm.get("status"),
        "node": vm.get("node") or pve.node,
        "cpus": coerce_int(vm.get("cpus")) or coerce_int(config.get("cores")),
        "maxmem": maxmem,
        "uptime": coerce_int(vm.get("uptime")),
        "instance_type": (
            (owner or {}).get("instance_type")
            or infer_instance_type(config, vm)
        ),
    }

    if owner:
        instance["owner"] = owner
        instance["owner_principal"] = owner.get("principal") or owner.get("acl_subject")
        instance["owner_email"] = owner.get("email")

    return instance


def disk_sort_key(name):
    match = re.match(r"([a-z]+)(\d+)$", str(name))
    if not match:
        return (str(name), 0)
    return (match.group(1), int(match.group(2)))


def find_free_disk_key(config, preferred=None):
    if preferred and preferred not in config:
        return preferred
    for index in range(1, 31):
        key = f"scsi{index}"
        if key not in config:
            return key
    print("No free SCSI disk slots are available", file=sys.stderr)
    sys.exit(1)


def root_disk_key(config):
    for prefix in ("scsi", "virtio", "sata", "ide"):
        for index in range(0, 32):
            key = f"{prefix}{index}"
            if key in config:
                return key
    return None


def normalize_disk_value(value):
    return str(value or "").split(",", 1)[0]


def find_disk_by_backing(config, backing):
    if not backing:
        return None
    target = normalize_disk_value(backing)
    for key, value in config.items():
        if not re.match(r"^(scsi|virtio|sata|ide)\d+$", str(key)):
            continue
        if normalize_disk_value(value) == target or str(value) == str(backing):
            return key
    return None


def find_unused_by_backing(config, backing):
    if not backing:
        return None
    target = normalize_disk_value(backing)
    for key, value in config.items():
        if not str(key).startswith("unused"):
            continue
        if normalize_disk_value(value) == target or str(value) == str(backing):
            return key
    return None


def sh_quote(value):
    return "'" + str(value).replace("'", "'\"'\"'") + "'"


def postgres_cloud_init(username, password, port):
    quoted_user = sh_quote(username)
    quoted_password = sh_quote(password)
    return f"""#cloud-config
package_update: true
packages:
  - qemu-guest-agent
  - postgresql
runcmd:
  - |
    set -eu
    systemctl enable --now qemu-guest-agent || true
    PG_VERSION="$(ls /etc/postgresql | sort -V | tail -1)"
    CONF="/etc/postgresql/${{PG_VERSION}}/main/postgresql.conf"
    HBA="/etc/postgresql/${{PG_VERSION}}/main/pg_hba.conf"
    sed -i "s/^#\\?listen_addresses.*/listen_addresses = '*'/" "$CONF"
    sed -i "s/^#\\?port.*/port = {int(port)}/" "$CONF"
    grep -q "calpolysoc cloud ipv4" "$HBA" || echo "host all all 0.0.0.0/0 scram-sha-256 # calpolysoc cloud ipv4" >> "$HBA"
    sudo -u postgres psql -v ON_ERROR_STOP=1 <<'SQL'
    DO $$
    BEGIN
      IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = {quoted_user}) THEN
        EXECUTE 'CREATE ROLE ' || quote_ident({quoted_user}) || ' LOGIN SUPERUSER PASSWORD ' || quote_literal({quoted_password});
      ELSE
        EXECUTE 'ALTER ROLE ' || quote_ident({quoted_user}) || ' WITH LOGIN SUPERUSER PASSWORD ' || quote_literal({quoted_password});
      END IF;
    END
    $$;
SQL
    systemctl restart postgresql
"""


def redis_cloud_init(password, port):
    quoted_password = sh_quote(password)
    return f"""#cloud-config
package_update: true
packages:
  - qemu-guest-agent
  - redis-server
runcmd:
  - |
    set -eu
    systemctl enable --now qemu-guest-agent || true
    CONF="/etc/redis/redis.conf"
    sed -i "s/^bind .*/bind 0.0.0.0 ::/" "$CONF"
    sed -i "s/^protected-mode .*/protected-mode yes/" "$CONF"
    sed -i "s/^port .*/port {int(port)}/" "$CONF"
    if grep -q '^# requirepass ' "$CONF"; then
      sed -i "s/^# requirepass .*/requirepass {quoted_password}/" "$CONF"
    elif grep -q '^requirepass ' "$CONF"; then
      sed -i "s/^requirepass .*/requirepass {quoted_password}/" "$CONF"
    else
      echo "requirepass {quoted_password}" >> "$CONF"
    fi
    systemctl enable redis-server
    systemctl restart redis-server
"""


